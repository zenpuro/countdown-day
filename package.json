{
  "name": "countdown-day",
  "version": "0.1.1",
  "description": "Obsidian plugin for tracking countdowns and memorial days (solar & lunar calendar) in a list view.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "gen:lunar": "node scripts/gen-lunar-table.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "countdown"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^25.0.1",
    "lunar-javascript": "^1.7.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.0.0"
  }
}
