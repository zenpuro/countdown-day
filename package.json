{
  "name": "countdown-day",
  "version": "0.1.0",
  "description": "Obsidian plugin for tracking countdowns and memorial days (solar & lunar calendar) in a list view.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "gen:lunar": "node scripts/gen-lunar-table.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "countdown"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "lunar-javascript": "^1.7.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
